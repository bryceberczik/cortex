generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "cockroachdb"
  url      = env("DATABASE_URL")
}

enum Provider {
  GOOGLE
  GITHUB
}

model User {
  id            String    @id @default(cuid())
  username      String
  email         String?
  provider      Provider
  providerId    String
  comments      Comment[]
  likedPosts    Post[]    @relation("UserLikesPosts")
  likedComments Comment[] @relation("UserLikesComments")
  createdAt     DateTime  @default(now()) @db.Timestamp(6)

  @@unique([provider, providerId])
}

model Post {
  id           String    @id @default(cuid())
  contentfulId String    @unique
  title        String
  content      String
  likedBy      User[]    @relation("UserLikesPosts")
  comments     Comment[]
  postedAt     DateTime  @default(now())
}

model Comment {
  id      String @id @default(cuid())
  content String
  likedBy User[] @relation("UserLikesComments")

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  postId String
  post   Post   @relation(fields: [postId], references: [id])

  postedAt DateTime @default(now())
}
