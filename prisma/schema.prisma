generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "cockroachdb"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique @db.String(20)
  email         String?
  password      String
  comments      Comment[]
  likedPosts    Post[]    @relation("UserLikesPosts")
  likedComments Comment[] @relation("UserLikesComments")
  createdAt     DateTime  @default(now()) @db.Timestamp(6)
}

model Post {
  id       String    @id @default(cuid())
  title    String
  content  String
  likedBy  User[]    @relation("UserLikesPosts")
  comments Comment[]
  postedAt DateTime  @default(now())
}

model Comment {
  id      String @id @default(cuid())
  content String
  likedBy User[] @relation("UserLikesComments")

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  postId String
  post   Post   @relation(fields: [postId], references: [id])

  postedAt DateTime @default(now())
}
